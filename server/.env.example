NODE_ENV=development

PORT=5000

MONGODB_URI=

JWT_SECRET=

GEMINI_API_KEY=

# Optional: Model for image generation (defaults to gemini-2.5-flash-image)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional: Dedicated API key for image generation (falls back to GEMINI_API_KEY if unset)
GEMINI_IMAGE_API_KEY=

CLIENT_URL=http://localhost:5173